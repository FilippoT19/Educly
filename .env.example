# Supabase — get these from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Admin panel password
ADMIN_SECRET=your-admin-password

# Guest demo account — create a user in Supabase Auth with these credentials
# and a matching row in the students table
NEXT_PUBLIC_GUEST_EMAIL=guest@yourdomain.com
NEXT_PUBLIC_GUEST_PASSWORD=guest-password-here
