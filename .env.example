# Supabase — get these from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Admin panel password
ADMIN_SECRET=your-admin-password

# Guest demo account — create a user via the Admin panel (/admin → Utenti)
# These are server-only (no NEXT_PUBLIC_ prefix — never sent to the browser)
GUEST_EMAIL=guest@yourdomain.com
GUEST_PASSWORD=your-guest-password
